# Copy this file to .env before deploying. Never commit the generated .env file.
APP_PORT=80
# Internal API route. Set to backend:8080 for a temporary direct-backend rollback.
API_UPSTREAM=cloud-gateway:8082
EUREKA_DEFAULT_ZONE=http://cloud-registry:8761/eureka/
SPRING_CLOUD_DISCOVERY_ENABLED=true
EUREKA_CLIENT_ENABLED=true
# Browser requests use /opentalking; Nginx forwards them to this host-side API.
OPENTALKING_UPSTREAM=host.docker.internal:8210

MYSQL_DATABASE=ai_interview
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_APP_USER=ai_interview_app
MYSQL_APP_PASSWORD=replace-with-a-long-random-application-password

REDIS_PASSWORD=replace-with-a-long-random-redis-password
# At least 32 characters. Generate a unique random value for every environment.
JWT_SECRET=replace-with-a-random-jwt-secret-at-least-32-characters
# 后端启动时校验 JWT_SECRET 非默认/占位值且长度≥32；本地开发如确需临时放行可设为 false（生产禁止）。
APP_REQUIRE_STRONG_JWT_SECRET=true

# Compose backend must fetch Eureka instances so synchronous Worker calls use LoadBalancer.
EUREKA_FETCH_REGISTRY=true

# 登录/注册/验证码接口的 Redis 限流阈值（按客户端 IP 计）
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_LOGIN_PER_MINUTE=10
AUTH_RATE_LIMIT_REGISTER_PER_MINUTE=5
AUTH_RATE_LIMIT_CODE_SEND_PER_MINUTE=3
AUTH_RATE_LIMIT_CODE_SEND_PER_DAY=20
AUTH_RATE_LIMIT_LOGIN_CODE_PER_MINUTE=10

# 算法判题沙箱（Java 17，Docker）
ALGORITHM_JUDGE_ENABLED=true
# 独立 algorithm-judge-worker 消费异步队列。
ALGORITHM_JUDGE_WORKER_CONSUMER_ENABLED=true
ALGORITHM_JUDGE_CONSUMER_NAME=
ALGORITHM_JUDGE_RUNNER_IMAGE=ai-java17-runner:2.0
ALGORITHM_JUDGE_DOCKER_HOST=unix:///var/run/docker.sock
ALGORITHM_JUDGE_OUTPUT_LIMIT_BYTES=8388608
ALGORITHM_JUDGE_SOURCE_LIMIT_CHARS=100000
ALGORITHM_JUDGE_MAX_TEST_CASES=50
ALGORITHM_JUDGE_COMPILE_TIMEOUT_SECONDS=30
ALGORITHM_JUDGE_CPU_COUNT=1
# Backend's private HTTP endpoint for synchronous custom-input runs.
ALGORITHM_JUDGE_WORKER_BASE_URL=http://algorithm-judge-worker:8084/api
# Compose uses Eureka + Spring Cloud LoadBalancer; local IDE runs can set this false.
ALGORITHM_JUDGE_WORKER_DISCOVERY_ENABLED=true
ALGORITHM_JUDGE_WORKER_SERVICE_ID=algorithm-judge-worker
ALGORITHM_JUDGE_WORKER_SERVICE_PATH=/api
ALGORITHM_JUDGE_WORKER_CONNECT_TIMEOUT_MS=2000
ALGORITHM_JUDGE_WORKER_READ_TIMEOUT_MS=30000
ALGORITHM_JUDGE_WORKER_CIRCUIT_BREAKER_NAME=algorithmJudgeWorker
ALGORITHM_JUDGE_WORKER_BULKHEAD_MAX_CONCURRENT=8
ALGORITHM_JUDGE_WORKER_BULKHEAD_MAX_WAIT_MS=0
# Optional shared secret; keep empty only on a strictly private local network.
ALGORITHM_JUDGE_INTERNAL_TOKEN=
# Production may mount a mode-0600 Docker/KMS secret at this path instead of using the environment variable.
ALGORITHM_JUDGE_INTERNAL_TOKEN_FILE=/run/secrets/algorithm-judge-internal-token
# Set true in production together with a non-empty ALGORITHM_JUDGE_INTERNAL_TOKEN.
ALGORITHM_JUDGE_REQUIRE_INTERNAL_TOKEN=false

# Production: materialize KMS Secrets Manager values here with mode 0600.
# Do not put real secret values in source control or an update archive.
APP_SECRETS_DIRECTORY=/run/secrets/
MANAGEMENT_PORT=8081
AI_TASK_SCHEDULER_ENABLED=true

# Set CLAMAV_REQUIRED=true only after a private ClamAV/clamd service is available.
CLAMAV_REQUIRED=false
CLAMAV_HOST=
CLAMAV_PORT=3310

# Per-question audio/video recording upload limits. Keep these three values aligned.
MEDIA_MAX_UPLOAD_BYTES=104857600
MEDIA_MAX_UPLOAD_SIZE=100MB
MEDIA_MAX_REQUEST_SIZE=105MB

DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TASK_POLL_INTERVAL_MS=1000
# AI 任务与报告评分使用有界并发；小规格云服务器建议保持默认值。
AI_TASK_FETCH_LIMIT=12
AI_TASK_WORKER_COUNT=3
AI_TASK_WORKER_QUEUE_CAPACITY=50
REPORT_SCORING_CONCURRENCY=3
REPORT_SCORING_QUEUE_CAPACITY=50

# Aliyun API Marketplace SMS uses APPCODE authorization.
REGISTER_SMS_HOST=https://dfsns.market.alicloudapi.com
REGISTER_SMS_PATH=/data/send_sms
REGISTER_SMS_APP_CODE=replace-with-your-marketplace-appcode
REGISTER_SMS_TEMPLATE_ID=CST_ptdie100

# QQ Mail uses an SMTP authorization code, not the QQ login password.
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-account@qq.com
MAIL_PASSWORD=replace-with-your-qq-smtp-authorization-code
MAIL_FROM=your-account@qq.com
# 邮件是可选通知渠道；只有需要将 SMTP 纳入整体健康状态时才改为 true。
MAIL_HEALTH_ENABLED=false
REGISTER_CODE_MAIL_SUBJECT=AInterview 验证码
PASSWORD_RESET_CODE_MAX_DAILY_SENDS=10
PASSWORD_RESET_CODE_MAX_VERIFY_FAILURES=5

# 可选 monitoring profile：Prometheus、Alertmanager、Grafana 仅绑定宿主机回环地址。
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# 必须替换为独立随机密码；不要提交真实密码。
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
GRAFANA_ROOT_URL=http://127.0.0.1:3000
